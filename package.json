  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.19.4",
    "nodemon": "^3.1.11",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "^5.0.1",
    "web-vitals": "^5.1.0"
  }
}
